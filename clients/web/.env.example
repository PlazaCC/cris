# Postgres (Neon) — use a connection string de uma branch dev para desenvolvimento
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Vercel Blob (imagens) — token read/write do Blob store
BLOB_READ_WRITE_TOKEN=

# Better Auth (login do /admin) — gere o secret com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública do site (em produção, o domínio da Vercel)
BETTER_AUTH_URL=http://localhost:4000
